{
  "manifest_version": 3,
  "name": "Markdown Beautifier",
  "version": "1.0.0",
  "description": "Shows Markdown (.md) files as clean, readable pages.",
  "minimum_chrome_version": "105",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*.md",
        "file:///*.markdown",
        "http://*/*.md",
        "https://*/*.md",
        "http://*/*.markdown",
        "https://*/*.markdown"
      ],
      "js": [
        "vendor/purify.min.js",
        "vendor/marked.umd.js",
        "src/content.js"
      ],
      "css": [
        "styles/viewer.css"
      ],
      "run_at": "document_end"
    }
  ]
}
